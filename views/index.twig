<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Chat en Ligne</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body data-username="{{ username }}">
    <section class="chat-container">
        <header class="chat-header">
            <h1>Chat</h1>
            <p class="user-info">
                Utilisateur: {{ username }} | En ligne: <span id="userCount"></span>
                <button id="logoutBtn" class="logout-btn">Déconnexion</button>
            </p>
        </header>
        
        <main class="messages-container">
            <ul id="messagesList">
                {% for message in messages %}
                <li class="message other-message">
                    <span class="message-header">{{ message.pseudo }}</span>
                    <div class="message-content">{{ message.content }}</div>
                    <small class="message-time">{{ message.createdAt|date('H:i') }}</small>
                </li>
                {% endfor %}
            </ul>
        </main>
        
        <footer class="input-container">
            <input type="text" id="messageInput" placeholder="Tapez votre message...">
            <button id="sendBtn">Envoyer</button>
        </footer>
    </section>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/main.js"></script>
</body>
</html>